{
  "installCommand": "git clone --depth 1 -b stable https://github.com/flutter/flutter.git flutter",
  "buildCommand": "test -n \"$API_BASE_URL\" || (echo \"ERREUR: variable API_BASE_URL absente. Le build aurait une URL backend vide et toutes les requetes casseraient.\" && exit 1) && flutter/bin/flutter pub get && flutter/bin/flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/push-sw/push.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/push_helper.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}